# Pinned source dependencies for PAS-DUAL-ARM (vcstool format).
#
# These five packages live under src/ as gitlinks with no .gitmodules, so a fresh
# clone of this repository does not pull them. This manifest records the exact
# upstream URL and commit each one was built against, so the workspace can be
# reconstructed reproducibly:
#
#   vcs import src < ros2.repos
#   ./scripts/apply_patches.sh        # reapply tracked local patches (see patches/)
#
# Versions are pinned to the exact commit (not a branch) so the build does not
# drift when upstream moves. The upstream branch each commit came from is noted
# in a comment for future deliberate updates.
#
# Every version here MUST be a commit that exists on the upstream remote. A
# local-only commit looks fine in this workspace and still breaks a fresh
# clone: vcs import cannot check it out, silently leaves the repository's
# default branch, and the build then fails somewhere unrelated. pan_tilt_ros
# was pinned to a local commit until 16. 9. 2026., which left fresh clones on
# the ROS 1 `master` branch and failed the whole workspace on find_package
# (catkin). Local changes to upstream packages belong in patches/, never in a
# commit that only exists here. Verify with:
#   git ls-remote <url> | grep <commit>        # must print the commit
repositories:
  aruco_ros:
    type: git
    url: https://github.com/pal-robotics/aruco_ros.git
    version: 86a0bbb76c935095334ba31682f0246efb44e148   # humble-devel, 5.0.5-1-g86a0bbb
  omni_base_simulation:
    type: git
    url: https://github.com/pal-robotics/omni_base_simulation.git
    version: 77248acbc811d9f5f7adc4e88e95e1f60d7bf883   # humble-devel, 2.12.0
  pan_tilt_ros:
    type: git
    url: https://github.com/I-Quotient-Robotics/pan_tilt_ros.git
    # humble-devel (ROS 2). NOT master, which is the ROS 1/catkin branch.
    # Our Ignition fix (inertials + effort limits) rides on top as
    # patches/pan_tilt_ros-inertials-and-effort-limits.patch.
    version: 9b0875817de805c126336f3ba68a1af718d393c6
  realsense-ros:
    type: git
    url: https://github.com/realsenseai/realsense-ros.git
    version: 6d87b071dcfef15f2a0407e1e78945256add70d0   # ros2-master, 4.57.6-42-g6d87b071
  ros2_kortex:
    type: git
    url: https://github.com/Kinovarobotics/ros2_kortex.git
    version: 116d87ae595c791ba7ae32201b88693a3ba02324   # humble, 0.2.3-29-g116d87a
