{
  "editor.formatOnSave": true,
  "editor.tabSize": 2,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.exclude": {
    "**/.DS_Store": true,
    "**/Thumbs.db": true
  },
  "search.exclude": {
    ".agents": true
  },
  "terminal.integrated.showOnStartup": "always",
  "workbench.editorAssociations": {
    "*.pdf": "latex-workshop-pdf-hook"
  },
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.latex.autoBuild.run": "onFileChange",
  "latex-workshop.latex.outDir": "%DIR%/build",
  "latex-workshop.view.pdf.internal.synctex.keybinding": "double-click",
  "ROS2.distro": "humble",
  "python.autoComplete.extraPaths": [
    "/home/khartl/astro_ws/install/astro_autonomous_racing/lib/python3.10/site-packages",
    "/home/khartl/ws_moveit2/install/moveit_task_constructor_core/local/lib/python3.10/dist-packages",
    "/home/khartl/ws_moveit2/install/moveit_py/local/lib/python3.10/dist-packages",
    "/home/khartl/ws_moveit2/build/moveit_configs_utils",
    "/home/khartl/ws_moveit2/install/moveit_configs_utils/lib/python3.10/site-packages",
    "/home/khartl/ws_moveit2/install/srdfdom/local/lib/python3.10/dist-packages",
    "/home/khartl/ws_moveit2/install/moveit_task_constructor_msgs/local/lib/python3.10/dist-packages",
    "/home/khartl/ws_moveit2/build/launch_param_builder",
    "/home/khartl/ws_moveit2/install/launch_param_builder/lib/python3.10/site-packages",
    "/opt/ros/humble/lib/python3.10/site-packages",
    "/opt/ros/humble/local/lib/python3.10/dist-packages"
  ]
}
