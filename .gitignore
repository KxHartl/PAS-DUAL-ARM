build/
install/
log/
.vscode/
.idea/
.venv/
__pycache__/
*.pyc
# Obsidian: postavke uredivaca, nisu dio simulacije - ostaju lokalno
/.obsidian/
# Assistant's email contains personal data - quoted in notes/01_zahtjevi/izvori.md instead
data/raw/zadatak/email_*
# SLAM maps: the .yaml/.pgm pair is what map_server and the keepout filter need and
# is tracked. The serialised pose graph is only needed to CONTINUE mapping, and the
# two files together are ~16 MB per map, so they stay local.
src/pas_dual_arm_bringup/maps/*.posegraph
src/pas_dual_arm_bringup/maps/*.data
# Timestamped map archives written by save_map.sh; only seminar_map.* is the active one.
src/pas_dual_arm_bringup/maps/map_2*
# Raw assistant session transcripts dumped at the repo root
/*-local-command-caveat*.txt
/codex-session-*.md
/*-zadatak-*.txt

# --- Priprema za predaju (16. 9. 2026.) ---
# Sve niže ostaje na disku; samo izlazi iz repozitorija, jer nije dio zadatka
# ni simulacije. Povijest je i dalje u gitu.

# AI/LiteRealm scaffolding
/.ai/
/CLAUDE.md
/GEMINI.md
/.env
/.env.example

# Zastarjeli dokumenti ranih faza; sadržaj koji vrijedi prenesen je u notes/
/TASK.md
/HUMAN.md
/LINKS.md
/STATE.md
/src/README.md

# docs/ je dio objavljenog repozitorija (upute + slike za README).
# Radni dokumenti ranih faza preseljeni su u notes/09_arhiva/ 17. 9.
# Izvor seminara (LaTeX, slike): gotov PDF je u rootu kao seminar.pdf
/seminar/

# Materijal zadatka (PDF i slike asistenta) i RAG scaffolding: nije nas rad,
# ostaje lokalno.
/data/
/dist/

# Hvat trenjem (D-21) vraćen je 17. 9. kao imenovan, odvojen pokus
# (scenario_friction_grasp.launch.py). Misija i dalje radi na `position`
# sučelju; ovo je alternativa koja se mjeri, ne dio isporuke.
# Pomoćne skripte za izolirano pokretanje ostaju lokalne.
/scripts/apply_measured_arm_gains.py
/scripts/new_force_run.sh
/scripts/run_force_isolated.sh
/scripts/stop_force_isolated.sh
/scripts/run_cube_isolated.sh

# Interaktivni studiji za definiranje poza: poze su snimljene i žive u
# postures.py; sam alat nije dio gotove simulacije.
/scripts/joint_gui.py
/src/pas_dual_arm_bringup/launch/pose_studio.launch.py
/src/pas_dual_arm_bringup/launch/grasp_stage.launch.py
/src/pas_dual_arm_scripts/pas_dual_arm_scripts/grasp_stage.py

# Jednokratne sonde i čvor koji se nigdje ne poziva
/src/pas_dual_arm_scripts/pas_dual_arm_scripts/set_camera.py
/scripts/probe_arm_posture_height.py
/scripts/probe_spawn_clearance.py
/scripts/probe_wrist_markers.py
