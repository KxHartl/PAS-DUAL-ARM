/scripts/probe_cube_perception.py
/scripts/probe_torso.py
/scripts/make_marker.py

# Vanjski paketi: skidaju se od autora preko `vcs import src < ros2.repos`.
# Repo nosi samo manifest, ne i njihov kod (ni gitlink pointere).
/src/aruco_ros/
/src/omni_base_simulation/
/src/pan_tilt_ros/
/src/realsense-ros/
/src/ros2_kortex/

# Validation output: measurement data and per-run logs/worlds, regenerated by
# validation/run_batch.py. The harness is tracked; its results are not.
/validation/results/

# Izlaz generatora svijeta (scripts/gen_world.py iz config/world.yaml).
# Prepisuje se pri svakom pokretanju; izvor je konfiguracija, ne rezultat.
/src/pas_dual_arm_bringup/worlds/generated_world.sdf
