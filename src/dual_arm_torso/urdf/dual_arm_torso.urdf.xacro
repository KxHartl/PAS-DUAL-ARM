<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="dual_arm_torso" params="parent *origin">
    
    <!-- Torso Base Link -->
    <link name="torso_base_link">
      <visual>
        <geometry>
          <mesh filename="package://dual_arm_torso/meshes/assembly_main_simplified.STL" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="torso_gray">
          <color rgba="0.6 0.6 0.6 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="-0.026 0.143 0.478" rpy="0 0 0"/>
        <geometry>
          <box size="0.566 0.284 0.956"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="-0.026 0.143 0.478" rpy="0 0 0"/>
        <mass value="12.0"/>
        <!-- Approximated inertia for a tall box -->
        <inertia ixx="1.0" ixy="0" ixz="0" iyy="1.0" iyz="0" izz="0.5"/>
      </inertial>
    </link>

    <!-- Joint attaching torso to parent (e.g. omni_base) -->
    <joint name="torso_base_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="torso_base_link"/>
    </joint>

    <!-- ================== LEFT CARRIAGE ================== -->
    <link name="left_carriage_link">
      <visual>
        <geometry>
          <mesh filename="package://dual_arm_torso/meshes/mts_carriage.STL" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="carriage_dark">
          <color rgba="0.2 0.2 0.2 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0.060 0.047 0.112" rpy="0 0 0"/>
        <geometry>
          <box size="0.120 0.053 0.214"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.060 0.047 0.112" rpy="0 0 0"/>
        <mass value="2.0"/>
        <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
      </inertial>
    </link>

    <joint name="torso_left_carriage_joint" type="prismatic">
      <parent link="torso_base_link"/>
      <child link="left_carriage_link"/>
      <!-- Estimated position of the left rail. We will refine this visually. -->
      <!-- The STL X range is -309 to +257. Let's put left carriage at X=-200, Y=100 -->
      <!-- We might need to rotate it if it faces the wrong way. -->
      <origin xyz="-0.086 0.1625 0.050" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="0.05" upper="0.8" effort="100.0" velocity="0.5"/>
    </joint>

    <!-- ================== RIGHT CARRIAGE ================== -->
    <link name="right_carriage_link">
      <visual>
        <geometry>
          <mesh filename="package://dual_arm_torso/meshes/mts_carriage.STL" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="carriage_dark">
          <color rgba="0.2 0.2 0.2 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0.060 0.047 0.112" rpy="0 0 0"/>
        <geometry>
          <box size="0.120 0.053 0.214"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.060 0.047 0.112" rpy="0 0 0"/>
        <mass value="2.0"/>
        <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
      </inertial>
    </link>

    <joint name="torso_right_carriage_joint" type="prismatic">
      <parent link="torso_base_link"/>
      <child link="right_carriage_link"/>
      <!-- Estimated position of the right rail. -->
      <origin xyz="0.035 0.1235 0.050" rpy="0 0 3.14159"/>
      <axis xyz="0 0 1"/>
      <limit lower="0.05" upper="0.8" effort="100.0" velocity="0.5"/>
    </joint>

    <!-- ================== WEDGES ================== -->
    <link name="left_wedge_link">
      <visual>
        <origin xyz="0.060 0 -0.060" rpy="0 0 1.5708"/>
        <geometry>
          <mesh filename="package://dual_arm_torso/meshes/wedge.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="wedge_blue">
          <color rgba="0.1 0.3 0.8 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0.060 0 -0.060" rpy="0 0 1.5708"/>
        <geometry>
          <mesh filename="package://dual_arm_torso/meshes/wedge.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <joint name="left_carriage_to_wedge" type="fixed">
      <parent link="left_carriage_link"/>
      <child link="left_wedge_link"/>
      <origin xyz="0.060 0.0735 0.112" rpy="0 0 0"/>
    </joint>

    <link name="right_wedge_link">
      <visual>
        <origin xyz="0.060 0 -0.060" rpy="0 0 1.5708"/>
        <geometry>
          <mesh filename="package://dual_arm_torso/meshes/wedge.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="wedge_blue">
          <color rgba="0.1 0.3 0.8 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0.060 0 -0.060" rpy="0 0 1.5708"/>
        <geometry>
          <mesh filename="package://dual_arm_torso/meshes/wedge.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <joint name="right_carriage_to_wedge" type="fixed">
      <parent link="right_carriage_link"/>
      <child link="right_wedge_link"/>
      <origin xyz="0.060 0.0735 0.112" rpy="0 0 0"/>
    </joint>

  </xacro:macro>
</robot>
