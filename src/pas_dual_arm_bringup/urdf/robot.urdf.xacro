<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="dual_arm_robot">

  <!-- Arguments -->
  <xacro:arg name="use_sim_time" default="true"/>
  <xacro:arg name="sim_ignition" default="true"/>
  
  <!-- 1. OMNI BASE -->
  <!-- We include ONLY the structural part of the omni_base (base_link, base_footprint,
       wheels, lasers, imu). We deliberately do NOT include robots/omni_base.urdf.xacro,
       because it appends a ros2_control block bound to gazebo_ros2_control/GazeboSystem
       (Gazebo Classic), which the ign_ros2_control plugin cannot load under Fortress.
       The base is instead driven by the Ignition MecanumDrive plugin (see section 5). -->
  <xacro:property name="namespace" value=""/>
  <xacro:property name="is_public_sim" value="true"/>
  <xacro:include filename="$(find pal_urdf_utils)/urdf/materials.urdf.xacro"/>
  <xacro:include filename="$(find pal_urdf_utils)/urdf/deg_to_rad.urdf.xacro"/>
  <xacro:include filename="$(find omni_base_description)/urdf/base/base_sensors.urdf.xacro"/>
  <xacro:base_sensors name="base" front_laser_model="sick-571" rear_laser_model="sick-571"/>

  <!-- 2. DUAL ARM TORSO -->
  <!-- We include our custom torso and attach it to the base_link -->
  <xacro:include filename="$(find dual_arm_torso)/urdf/dual_arm_torso.urdf.xacro"/>
  <!-- The origin here defines where the torso is mounted on the omni_base. 
       Let's place it at the center of the base, somewhat elevated. -->
  <xacro:dual_arm_torso parent="base_footprint">
    <origin xyz="0.026 -0.143 0.31" rpy="0 0 0"/>
  </xacro:dual_arm_torso>

  <!-- 3. KINOVA GEN3 ARMS -->
  <xacro:include filename="$(find kortex_description)/robots/kortex_robot.xacro"/>
  
  <!-- Left Arm -->
  <xacro:load_robot 
    parent="left_wedge_link" 
    prefix="left_" 
    arm="gen3" 
    gripper="robotiq_2f_85" 
    gripper_joint_name="left_robotiq_85_left_knuckle_joint"
    dof="7" 
    vision="true" 
    robot_ip="xxx.yyy.zzz.www" 
    username="admin" 
    password="admin" 
    port="10000" 
    port_realtime="10001" 
    session_inactivity_timeout_ms="60000" 
    connection_inactivity_timeout_ms="2000" 
    sim_ignition="$(arg sim_ignition)">
    <origin xyz="0 0.060 0" rpy="-0.785398 0 0"/>
  </xacro:load_robot>

  <!-- Right Arm -->
  <xacro:load_robot 
    parent="right_wedge_link" 
    prefix="right_" 
    arm="gen3" 
    gripper="robotiq_2f_85" 
    gripper_joint_name="right_robotiq_85_left_knuckle_joint"
    dof="7" 
    vision="true" 
    robot_ip="xxx.yyy.zzz.www" 
    username="admin" 
    password="admin" 
    port="10000" 
    port_realtime="10001" 
    session_inactivity_timeout_ms="60000" 
    connection_inactivity_timeout_ms="2000" 
    sim_ignition="$(arg sim_ignition)">
    <origin xyz="0 0.060 0" rpy="0.785398 0 3.14159"/>
  </xacro:load_robot>

  <!-- 4. PAN-TILT & REALSENSE -->
  <!-- Include pan_tilt URDF -->
  <xacro:include filename="$(find pan_tilt_description)/urdf/pan_tilt.urdf.xacro"/>
  <xacro:pan_tilt parent="torso_base_link">
    <!-- Place the pan-tilt on the front beam (moved back to sit on the beam) -->
    <origin xyz="0.060 0.143 0.956" rpy="0 0 0"/>
  </xacro:pan_tilt>

  <!-- Include Realsense D435 camera URDF -->
  <!-- Wait, realsense2_description uses _d435.urdf.xacro. -->
  <xacro:include filename="$(find realsense2_description)/urdf/_d435.urdf.xacro"/>
  <!-- Attach the camera to the pan_tilt top link -->
  <xacro:sensor_d435 parent="pan_tilt_surface" name="camera" use_nominal_extrinsics="true">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:sensor_d435>

  <!-- 4.4 WHEEL FRICTION OVERRIDE -->
  <!-- PAL's wheel.gazebo.xacro sets mu1=mu2=0.0 on every wheel (their Classic sim
       drives the base kinematically with planar_move, so wheels are decorative).
       Our diff_drive base actually rolls on the wheels, so give them rolling
       traction (mu1) but LOW lateral friction (mu2): this is a rigid 4-wheel
       skid-steer, so turning in place needs the wheels to slide sideways. With
       high mu2 the base could only drive straight and would not rotate at all
       (the 360 scan and all turns were impossible). -->
  <xacro:macro name="wheel_friction" params="side">
    <gazebo reference="wheel_${side}_link">
      <mu1>0.4</mu1>
      <mu2>0.0</mu2>
      <kp>1000000.0</kp>
      <kd>1000.0</kd>
      <minDepth>0.003</minDepth>
    </gazebo>
  </xacro:macro>
  <xacro:wheel_friction side="front_left"/>
  <xacro:wheel_friction side="front_right"/>
  <xacro:wheel_friction side="rear_left"/>
  <xacro:wheel_friction side="rear_right"/>

  <!-- 4.5 GRIPPER FINGER-TIP FRICTION -->
  <!-- The 85 mm Robotiq grippers cannot enclose the 300 mm box, so it is held
       by a two-arm friction squeeze: each gripper's finger tips press a side
       face and the carriages lift. Give those tip links high friction and a
       stiff contact so the squeeze actually carries the 1 kg box. -->
  <xacro:macro name="tip_friction" params="link">
    <gazebo reference="${link}">
      <mu1>5.0</mu1>
      <mu2>5.0</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <minDepth>0.002</minDepth>
    </gazebo>
  </xacro:macro>
  <xacro:tip_friction link="left_robotiq_85_left_finger_tip_link"/>
  <xacro:tip_friction link="left_robotiq_85_right_finger_tip_link"/>
  <xacro:tip_friction link="right_robotiq_85_left_finger_tip_link"/>
  <xacro:tip_friction link="right_robotiq_85_right_finger_tip_link"/>
  <xacro:tip_friction link="left_robotiq_85_left_finger_link"/>
  <xacro:tip_friction link="left_robotiq_85_right_finger_link"/>
  <xacro:tip_friction link="right_robotiq_85_left_finger_link"/>
  <xacro:tip_friction link="right_robotiq_85_right_finger_link"/>

  <!-- 4.6 CONTACT-VERIFIED GRASP ATTACH (DetachableJoint) -->
  <!-- DART will not hold a free object by gripper friction (tried mu up to 5,
       light box, high clamp effort - the box never rises). So once the grasp is
       CONFIRMED (main_task's contact check verifies both finger tips are on the
       box, in base_link), the box is rigidly fixed to the left wrist and lifted
       as a rigid body. This is physically justified by the verified contact (not
       the old teleport-to-midpoint). The joint starts attached, so main_task
       detaches it at startup and re-attaches only after the contact check. -->
  <gazebo>
    <plugin filename="ignition-gazebo-detachable-joint-system"
            name="ignition::gazebo::systems::DetachableJoint">
      <parent_link>left_bracelet_link</parent_link>
      <child_model>aruco_box</child_model>
      <child_link>box_link</child_link>
      <attach_topic>/aruco_box/attach</attach_topic>
      <detach_topic>/aruco_box/detach</detach_topic>
    </plugin>
  </gazebo>

  <!-- 4.5 IGNITION SENSORS -->
  <!-- The PAL base ships Gazebo-Classic gpu_ray lasers and the RealSense macro has no
       Gazebo sensor at all, so neither emits under Fortress. We add native Ignition
       sensors here; the world already loads the ignition sensors-system plugin. -->

  <!-- 360 deg 2D lidar for Nav2/SLAM, on the base's virtual laser frame -->
  <gazebo reference="virtual_base_laser_link">
    <sensor name="base_lidar" type="gpu_lidar">
      <topic>scan</topic>
      <update_rate>10</update_rate>
      <always_on>1</always_on>
      <visualize>true</visualize>
      <ignition_frame_id>virtual_base_laser_link</ignition_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.141592</min_angle>
            <max_angle>3.141592</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.12</min>
          <max>20.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <!-- RGBD camera on the pan-tilt RealSense: RGB for Aruco marker detection
       (camera/image) + depth image and point cloud (camera/depth_image,
       camera/points) so the box pose and dimensions can be measured by the
       depth sensor for the grasp plan. -->
  <gazebo reference="camera_link">
    <sensor name="rgbd_camera" type="rgbd_camera">
      <topic>camera</topic>
      <update_rate>15</update_rate>
      <always_on>1</always_on>
      <visualize>true</visualize>
      <ignition_frame_id>camera_color_optical_frame</ignition_frame_id>
      <camera>
        <horizontal_fov>1.211</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>20.0</far>
        </clip>
        <depth_camera>
          <clip>
            <near>0.1</near>
            <far>10.0</far>
          </clip>
        </depth_camera>
      </camera>
    </sensor>
  </gazebo>

  <!-- 5. ROS2_CONTROL FOR TORSO AND PAN-TILT -->
  <!-- The Kinova arms and Robotiq grippers already declare their own
       ign_ros2_control blocks (via load_robot, sim_ignition:=true). The custom torso
       carriages and the pan-tilt joints do not, so we declare them here. -->
  <!-- Wheel drive through ros2_control (velocity interfaces) + diff_drive_controller.
       The PAL ros2_control block targets Gazebo Classic and the Fortress built-in
       drive systems (MecanumDrive/VelocityControl) never instantiate on this
       install, while gz_ros2_control demonstrably works - so the wheels are driven
       the same way as every other joint of this robot. -->
  <ros2_control name="base_wheels_system" type="system">
    <hardware>
      <plugin>ign_ros2_control/IgnitionSystem</plugin>
    </hardware>
    <joint name="wheel_front_left_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wheel_front_right_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wheel_rear_left_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wheel_rear_right_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <ros2_control name="torso_system" type="system">
    <hardware>
      <plugin>ign_ros2_control/IgnitionSystem</plugin>
    </hardware>
    <joint name="torso_left_carriage_joint">
      <!-- ign_ros2_control realises a position command as a velocity
           (joint_velocity = position_proportional_gain * error). The default
           gain (0.1) drives light joints (arms, pan-tilt) but leaves the heavy
           vertical carriage pinned at its lower limit under gravity, so raise
           the gain for the carriages. -->
      <command_interface name="position">
        <param name="min">0.05</param>
        <param name="max">0.8</param>
        <param name="position_proportional_gain">20.0</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.05</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="torso_right_carriage_joint">
      <command_interface name="position">
        <param name="min">0.05</param>
        <param name="max">0.8</param>
        <param name="position_proportional_gain">20.0</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.05</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <ros2_control name="pan_tilt_system" type="system">
    <hardware>
      <plugin>ign_ros2_control/IgnitionSystem</plugin>
    </hardware>
    <joint name="pan_tilt_yaw_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="pan_tilt_pitch_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- 6. IGNITION SYSTEM PLUGINS -->
  <gazebo>
    <!-- ros2_control manager: loads ALL ros2_control blocks (arms, grippers, torso, pan-tilt) -->
    <plugin filename="ign_ros2_control-system" name="ign_ros2_control::IgnitionROS2ControlPlugin">
      <parameters>$(find pas_dual_arm_bringup)/config/controllers.yaml</parameters>
    </plugin>

    <!-- Base motion + odometry are handled by the ros2_control diff_drive
         base_controller (see base_wheels_system above and controllers.yaml).
         The Fortress built-in drive systems (MecanumDrive, VelocityControl) were
         tried first but never instantiate on this install. -->
  </gazebo>

</robot>
