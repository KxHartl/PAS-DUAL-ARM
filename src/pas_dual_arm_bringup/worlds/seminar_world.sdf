<?xml version="1.0" ?>
<sdf version="1.8">
  <!-- Three rooms in an L (decision D-13, 2026-09-13), robot home at the origin
       facing +X:
         HOME (grey)  x in [-3, 3], y in [-3, 3]  - robot spawn, mapping start
         BLUE (right) x in [-3, 3], y in [-9,-3]  - table with the ArUco box
         RED  (ahead) x in [ 3, 9], y in [-3, 3]  - destination table
       Rooms are 6 x 6 m and connect to HOME through a 1.0 m doorway. The robot
       is 0.85 m wide with its arms tucked, so 1.0 m leaves 7.3 cm per side.
       The world name must stay "seminar_world": the contact-sensor bridge
       topics (bridge.yaml) embed it. -->
  <world name="seminar_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin
      filename="libignition-gazebo-physics-system.so"
      name="ignition::gazebo::systems::Physics">
    </plugin>
    <plugin
      filename="libignition-gazebo-user-commands-system.so"
      name="ignition::gazebo::systems::UserCommands">
    </plugin>
    <plugin
      filename="libignition-gazebo-scene-broadcaster-system.so"
      name="ignition::gazebo::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="libignition-gazebo-sensors-system.so"
      name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <!-- Contact system: required for the fingertip <sensor type="contact">
         sensors (defined in robot.urdf.xacro) to publish, so the grasp is
         confirmed by real finger-box contact, not geometry alone. -->
    <plugin
      filename="libignition-gazebo-contact-system.so"
      name="ignition::gazebo::systems::Contact">
    </plugin>

    <!-- GUI: stock Fortress plugin set, with a narrower lens (46 deg
         instead of the 90 deg default) and an overview camera pose. -->
    <gui fullscreen="0">
    <plugin filename="MinimalScene" name="3D View">
      <ignition-gui>
        <title>3D View</title>
        <property type="bool" key="showTitleBar">false</property>
        <property type="string" key="state">docked</property>
      </ignition-gui>
    
      <engine>ogre2</engine>
      <scene>scene</scene>
      <ambient_light>0.4 0.4 0.4</ambient_light>
      <background_color>0.8 0.8 0.8</background_color>
      <camera_pose>-8 -16 12 0 0.61 0.87</camera_pose>
      <!-- 0.80 rad = 46 deg. The plugin default is 90 deg,
           which is what made the view look fish-eyed. -->
      <horizontal_fov>0.80</horizontal_fov>
    </plugin>
    <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
      <ignition-gui>
        <property key="state" type="string">floating</property>
        <property key="width" type="double">5</property>
        <property key="height" type="double">5</property>
        <property key="showTitleBar" type="bool">false</property>
      </ignition-gui>
    </plugin>
    <plugin filename="GzSceneManager" name="Scene Manager">
      <ignition-gui>
        <property key="resizable" type="bool">false</property>
        <property key="width" type="double">5</property>
        <property key="height" type="double">5</property>
        <property key="state" type="string">floating</property>
        <property key="showTitleBar" type="bool">false</property>
      </ignition-gui>
    </plugin>
    <plugin filename="InteractiveViewControl" name="Interactive view control">
      <ignition-gui>
        <property key="resizable" type="bool">false</property>
        <property key="width" type="double">5</property>
        <property key="height" type="double">5</property>
        <property key="state" type="string">floating</property>
        <property key="showTitleBar" type="bool">false</property>
      </ignition-gui>
    </plugin>
    <plugin filename="CameraTracking" name="Camera Tracking">
      <ignition-gui>
        <property key="resizable" type="bool">false</property>
        <property key="width" type="double">5</property>
        <property key="height" type="double">5</property>
        <property key="state" type="string">floating</property>
        <property key="showTitleBar" type="bool">false</property>
      </ignition-gui>
    </plugin>
    <plugin filename="MarkerManager" name="Marker manager">
      <ignition-gui>
        <property key="resizable" type="bool">false</property>
        <property key="width" type="double">5</property>
        <property key="height" type="double">5</property>
        <property key="state" type="string">floating</property>
        <property key="showTitleBar" type="bool">false</property>
      </ignition-gui>
    </plugin>
    <plugin filename="SelectEntities" name="Select Entities">
      <ignition-gui>
        <property key="resizable" type="bool">false</property>
        <property key="width" type="double">5</property>
        <property key="height" type="double">5</property>
        <property key="state" type="string">floating</property>
        <property key="showTitleBar" type="bool">false</property>
      </ignition-gui>
    </plugin>
    <plugin filename="Spawn" name="Spawn Entities">
      <ignition-gui>
        <property key="resizable" type="bool">false</property>
        <property key="width" type="double">5</property>
        <property key="height" type="double">5</property>
        <property key="state" type="string">floating</property>
        <property key="showTitleBar" type="bool">false</property>
      </ignition-gui>
    </plugin>
    <plugin filename="VisualizationCapabilities" name="Visualization Capabilities">
      <ignition-gui>
        <property key="resizable" type="bool">false</property>
        <property key="width" type="double">5</property>
        <property key="height" type="double">5</property>
        <property key="state" type="string">floating</property>
        <property key="showTitleBar" type="bool">false</property>
      </ignition-gui>
    </plugin>
    <plugin filename="WorldControl" name="World control">
      <ignition-gui>
        <title>World control</title>
        <property type="bool" key="showTitleBar">false</property>
        <property type="bool" key="resizable">false</property>
        <property type="double" key="height">72</property>
        <property type="double" key="width">121</property>
        <property type="double" key="z">1</property>
    
        <property type="string" key="state">floating</property>
        <anchors target="3D View">
          <line own="left" target="left"/>
          <line own="bottom" target="bottom"/>
        </anchors>
      </ignition-gui>
    
      <play_pause>true</play_pause>
      <step>true</step>
      <start_paused>true</start_paused>
      <use_event>true</use_event>
    
    </plugin>
    <plugin filename="WorldStats" name="World stats">
      <ignition-gui>
        <title>World stats</title>
        <property type="bool" key="showTitleBar">false</property>
        <property type="bool" key="resizable">false</property>
        <property type="double" key="height">110</property>
        <property type="double" key="width">290</property>
        <property type="double" key="z">1</property>
    
        <property type="string" key="state">floating</property>
        <anchors target="3D View">
          <line own="right" target="right"/>
          <line own="bottom" target="bottom"/>
        </anchors>
      </ignition-gui>
    
      <sim_time>true</sim_time>
      <real_time>true</real_time>
      <real_time_factor>true</real_time_factor>
      <iterations>true</iterations>
    </plugin>
    <plugin filename="Shapes" name="Shapes">
      <ignition-gui>
        <property key="resizable" type="bool">false</property>
        <property key="x" type="double">0</property>
        <property key="y" type="double">0</property>
        <property key="width" type="double">250</property>
        <property key="height" type="double">50</property>
        <property key="state" type="string">floating</property>
        <property key="showTitleBar" type="bool">false</property>
        <property key="cardBackground" type="string">#666666</property>
      </ignition-gui>
    </plugin>
    <plugin filename="Lights" name="Lights">
      <ignition-gui>
        <property key="resizable" type="bool">false</property>
        <property key="x" type="double">250</property>
        <property key="y" type="double">0</property>
        <property key="width" type="double">150</property>
        <property key="height" type="double">50</property>
        <property key="state" type="string">floating</property>
        <property key="showTitleBar" type="bool">false</property>
        <property key="cardBackground" type="string">#666666</property>
      </ignition-gui>
    </plugin>
    <plugin filename="TransformControl" name="Transform control">
      <ignition-gui>
        <property key="resizable" type="bool">false</property>
        <property key="x" type="double">0</property>
        <property key="y" type="double">50</property>
        <property key="width" type="double">250</property>
        <property key="height" type="double">50</property>
        <property key="state" type="string">floating</property>
        <property key="showTitleBar" type="bool">false</property>
        <property key="cardBackground" type="string">#777777</property>
      </ignition-gui>
    
      <!-- disable legacy features used to connect this plugin to GzScene3D -->
      <legacy>false</legacy>
    </plugin>
    <plugin filename="Screenshot" name="Screenshot">
      <ignition-gui>
        <property key="resizable" type="bool">false</property>
        <property key="x" type="double">250</property>
        <property key="y" type="double">50</property>
        <property key="width" type="double">50</property>
        <property key="height" type="double">50</property>
        <property key="state" type="string">floating</property>
        <property key="showTitleBar" type="bool">false</property>
        <property key="cardBackground" type="string">#777777</property>
      </ignition-gui>
    </plugin>
    <plugin filename="CopyPaste" name="CopyPaste">
      <ignition-gui>
        <property key="resizable" type="bool">false</property>
        <property key="x" type="double">300</property>
        <property key="y" type="double">50</property>
        <property key="width" type="double">100</property>
        <property key="height" type="double">50</property>
        <property key="state" type="string">floating</property>
        <property key="showTitleBar" type="bool">false</property>
        <property key="cardBackground" type="string">#777777</property>
      </ignition-gui>
    </plugin>
    <plugin filename="ComponentInspector" name="Component inspector">
      <ignition-gui>
        <property type="bool" key="showTitleBar">false</property>
        <property type="string" key="state">docked</property>
      </ignition-gui>
    </plugin>
    <plugin filename="EntityTree" name="Entity tree">
      <ignition-gui>
        <property type="bool" key="showTitleBar">false</property>
        <property type="string" key="state">docked</property>
      </ignition-gui>
    </plugin>
    </gui>

    <!-- Light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Room floor tints: visual only (no collision), 2 mm above the ground so
         the rooms read at a glance in the GUI. The 2D lidar scans far above
         them and the depth box segmentation ignores z < 0.12. -->
    <model name="room_floors">
      <static>true</static>
      <link name="floors">
        <visual name="home_floor">
          <pose>0 0 0.001 0 0 0</pose>
          <geometry><box><size>6 6 0.002</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
        <visual name="blue_floor">
          <pose>0 -6 0.001 0 0 0</pose>
          <geometry><box><size>6 6 0.002</size></box></geometry>
          <material><ambient>0.70 0.78 0.95 1</ambient><diffuse>0.70 0.78 0.95 1</diffuse></material>
        </visual>
        <visual name="red_floor">
          <pose>6 0 0.001 0 0 0</pose>
          <geometry><box><size>6 6 0.002</size></box></geometry>
          <material><ambient>0.95 0.72 0.72 1</ambient><diffuse>0.95 0.72 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Walls: 0.1 m thick, 3.0 m high. Height matters: the pan-tilt camera
         sits at 1.39 m, so the earlier 1.2 m walls let the robot look straight
         over them into the other rooms and skip navigating there entirely
         (notes P-36). Lengths carry +0.1 m so the corners close. Doorways are
         gaps of 1.0 m centred on each shared wall (door edges at +/-0.50). -->
    <model name="rooms">
      <static>true</static>

      <!-- HOME: left (+Y) and back (-X) walls -->
      <link name="home_left">
        <pose>0 3 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>6.1 0.1 3.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6.1 0.1 3.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
      <link name="home_back">
        <pose>-3 0 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.1 6.1 3.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 6.1 3.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>

      <!-- HOME <-> RED wall at X=3 with the 1.0 m door at Y in [-0.5, 0.5] -->
      <link name="door_red_left">
        <pose>3 1.75 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.1 2.5 3.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 2.5 3.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
      <link name="door_red_right">
        <pose>3 -1.75 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.1 2.5 3.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 2.5 3.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>

      <!-- HOME <-> BLUE wall at Y=-3 with the 1.0 m door at X in [-0.5, 0.5] -->
      <link name="door_blue_front">
        <pose>1.75 -3 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>2.5 0.1 3.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.5 0.1 3.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
      <link name="door_blue_back">
        <pose>-1.75 -3 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>2.5 0.1 3.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.5 0.1 3.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>

      <!-- RED room (destination) -->
      <link name="red_left">
        <pose>6 3 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>6.1 0.1 3.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6.1 0.1 3.0</size></box></geometry>
          <material><ambient>0.8 0.25 0.25 1</ambient><diffuse>0.8 0.25 0.25 1</diffuse></material></visual>
      </link>
      <link name="red_far">
        <pose>9 0 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.1 6.1 3.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 6.1 3.0</size></box></geometry>
          <material><ambient>0.8 0.25 0.25 1</ambient><diffuse>0.8 0.25 0.25 1</diffuse></material></visual>
      </link>
      <link name="red_right">
        <pose>6 -3 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>6.1 0.1 3.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6.1 0.1 3.0</size></box></geometry>
          <material><ambient>0.8 0.25 0.25 1</ambient><diffuse>0.8 0.25 0.25 1</diffuse></material></visual>
      </link>

      <!-- BLUE room (box) -->
      <link name="blue_back">
        <pose>-3 -6 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.1 6.1 3.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 6.1 3.0</size></box></geometry>
          <material><ambient>0.25 0.35 0.8 1</ambient><diffuse>0.25 0.35 0.8 1</diffuse></material></visual>
      </link>
      <link name="blue_far">
        <pose>0 -9 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>6.1 0.1 3.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6.1 0.1 3.0</size></box></geometry>
          <material><ambient>0.25 0.35 0.8 1</ambient><diffuse>0.25 0.35 0.8 1</diffuse></material></visual>
      </link>
      <link name="blue_front">
        <pose>3 -6 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.1 6.1 3.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 6.1 3.0</size></box></geometry>
          <material><ambient>0.25 0.35 0.8 1</ambient><diffuse>0.25 0.35 0.8 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Pick table (BLUE room): low table, top at Z=0.10, rotated so its 0.4 m
         depth runs along -Y (away from the door). Same design and box overhang
         as the previously verified setup, so the grasp geometry is unchanged. -->
    <model name="pick_table">
      <static>true</static>
      <pose>0 -6.5 0 0 0 -1.5708</pose>
      <link name="table">
        <collision name="slab_c">
          <pose>0 0 0.08 0 0 0</pose>
          <geometry><box><size>0.4 0.5 0.04</size></box></geometry>
        </collision>
        <visual name="slab_v">
          <pose>0 0 0.08 0 0 0</pose>
          <geometry><box><size>0.4 0.5 0.04</size></box></geometry>
          <material><ambient>0.5 0.35 0.2 1</ambient><diffuse>0.5 0.35 0.2 1</diffuse></material>
        </visual>
        <collision name="pillar_c">
          <pose>0 0 0.04 0 0 0</pose>
          <geometry><box><size>0.12 0.12 0.08</size></box></geometry>
        </collision>
        <visual name="pillar_v">
          <pose>0 0 0.04 0 0 0</pose>
          <geometry><box><size>0.12 0.12 0.08</size></box></geometry>
          <material><ambient>0.4 0.28 0.16 1</ambient><diffuse>0.4 0.28 0.16 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- The box (decision D-14): size is free per the assignment, so it keeps
         the 0.30 m cube the dual-arm squeeze grasp is tuned and verified for,
         but is a light plastic box (0.3 kg). On the pick table's near edge,
         yawed so the marked -X face points +Y, i.e. straight at the BLUE door:
         the robot entering the room sees the marker head-on. The 85 mm gripper
         cannot enclose a 0.3 m face, so both closed grippers press opposite
         side faces (contact-verified) and the attach joint carries it.
         Centre Z = table top 0.10 + 0.15. -->
    <model name="aruco_box">
      <pose>0 -6.38 0.25 0 0 -1.5708</pose>
      <link name="box_link">
        <inertial>
          <mass>0.3</mass>
          <!-- Solid cube 0.3 m, m=0.3 kg: I = m*s^2/6 = 0.0045. -->
          <inertia>
            <ixx>0.0045</ixx>
            <iyy>0.0045</iyy>
            <izz>0.0045</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box><size>0.30 0.30 0.30</size></box>
          </geometry>
          <!-- High friction + stiff contact so the pressed pads don't slide on
               the faces while the squeeze is verified. -->
          <surface>
            <friction>
              <ode>
                <mu>5.0</mu>
                <mu2>5.0</mu2>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>300000.0</kp>
                <kd>1.0</kd>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.30 0.30 0.30</size></box>
          </geometry>
          <material>
            <ambient>0.9 0.75 0.1 1</ambient>
            <diffuse>0.9 0.75 0.1 1</diffuse>
          </material>
        </visual>
        <!-- Aruco marker on the -X face (0.30 x 0.30). A 0.22 m plate whose ±X
             faces show the marker; the PNG has a 12.5% quiet zone so the marker
             proper is 0.165 m -> detector marker_size must match. -->
        <visual name="marker">
          <pose>-0.1505 0 0 0 0 0</pose>
          <geometry>
            <box><size>0.001 0.22 0.22</size></box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0 0 0 1</specular>
            <pbr>
              <metal>
                <albedo_map>materials/textures/aruco_marker_0.png</albedo_map>
                <metalness>0.0</metalness>
                <roughness>1.0</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- Place table (RED room, destination): same low height as the pick table
         (top 0.10), so the place step lowers the box to the pick height (the
         existing STEP8 logic) and the table stops it. Generous 0.6 x 0.6 top
         to absorb navigation spread. -->
    <model name="place_table">
      <static>true</static>
      <pose>6.5 0 0 0 0 0</pose>
      <link name="table">
        <collision name="slab_c">
          <pose>0 0 0.08 0 0 0</pose>
          <geometry><box><size>0.6 0.6 0.04</size></box></geometry>
        </collision>
        <visual name="slab_v">
          <pose>0 0 0.08 0 0 0</pose>
          <geometry><box><size>0.6 0.6 0.04</size></box></geometry>
          <material><ambient>0.5 0.35 0.2 1</ambient><diffuse>0.5 0.35 0.2 1</diffuse></material>
        </visual>
        <collision name="pillar_c">
          <pose>0 0 0.04 0 0 0</pose>
          <geometry><box><size>0.12 0.12 0.08</size></box></geometry>
        </collision>
        <visual name="pillar_v">
          <pose>0 0 0.04 0 0 0</pose>
