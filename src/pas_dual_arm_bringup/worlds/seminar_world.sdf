<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="seminar_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin
      filename="libignition-gazebo-physics-system.so"
      name="ignition::gazebo::systems::Physics">
    </plugin>
    <plugin
      filename="libignition-gazebo-user-commands-system.so"
      name="ignition::gazebo::systems::UserCommands">
    </plugin>
    <plugin
      filename="libignition-gazebo-scene-broadcaster-system.so"
      name="ignition::gazebo::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="libignition-gazebo-sensors-system.so"
      name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    
    <!-- Light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Wall with 2.0m Doorway -->
    <model name="wall_with_door">
      <static>true</static>
      <pose>2.0 0 0 0 0 0</pose> <!-- Wall is 2 meters in front of origin -->

      <!-- Left part of the wall (inner edge at Y=1.0 -> 2.0m opening) -->
      <link name="wall_left">
        <pose>0 2.0 1 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box><size>0.2 2.0 2.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.2 2.0 2.0</size></box>
          </geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient></material>
        </visual>
      </link>

      <!-- Right part of the wall -->
      <!-- Door is between Y=-1.0 and Y=1.0 (2.0m wide). -->
      <link name="wall_right">
        <pose>0 -2.0 1 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box><size>0.2 2.0 2.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.2 2.0 2.0</size></box>
          </geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient></material>
        </visual>
      </link>
      
      <!-- Top header above the door (from Z=2.0 to 2.5) -->
      <link name="door_header">
        <pose>0 0 2.25 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box><size>0.2 2.0 0.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.2 2.0 0.5</size></box>
          </geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- The Table (Final Destination) -->
    <model name="target_table">
      <static>true</static>
      <!-- Placed 2m beyond the wall, so X=4.0, Y=0.0 -->
      <pose>4.0 0 0 0 0 0</pose>
      <link name="table_top">
        <pose>0 0 0.75 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box><size>1.0 1.5 0.05</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>1.0 1.5 0.05</size></box>
          </geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient></material>
        </visual>
      </link>
      <!-- We can skip legs or add simple boxes for legs -->
    </model>

    <!-- Pick table: a low table (top at Z=0.10) to the RIGHT of the robot, so
         the robot must turn to find it. Low enough that the grasp stays within
         the arms' reach. Square slab. -->
    <model name="pick_table">
      <static>true</static>
      <!-- Forward-right of the robot. Front edge at X=1.20 (table extends back,
           away from the robot) so the box sits at the near edge and the long
           robot can reach it without the table blocking the base. -->
      <pose>1.40 -1.0 0 0 0 0</pose>
      <link name="table">
        <collision name="slab_c">
          <pose>0 0 0.08 0 0 0</pose>
          <geometry><box><size>0.4 0.5 0.04</size></box></geometry>
        </collision>
        <visual name="slab_v">
          <pose>0 0 0.08 0 0 0</pose>
          <geometry><box><size>0.4 0.5 0.04</size></box></geometry>
          <material><ambient>0.5 0.35 0.2 1</ambient><diffuse>0.5 0.35 0.2 1</diffuse></material>
        </visual>
        <collision name="pillar_c">
          <pose>0 0 0.04 0 0 0</pose>
          <geometry><box><size>0.12 0.12 0.08</size></box></geometry>
        </collision>
        <visual name="pillar_v">
          <pose>0 0 0.04 0 0 0</pose>
          <geometry><box><size>0.12 0.12 0.08</size></box></geometry>
          <material><ambient>0.4 0.28 0.16 1</ambient><diffuse>0.4 0.28 0.16 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- The Pick Target: an upright slab (marker ON the box, per the assignment).
         0.06 (X, the gripped thickness, fits the 85 mm gripper) x 0.30 (Y, length:
         each arm grips one end) x 0.20 (Z, height: carries the marker and gives
         the finger pads full contact). 0.4 kg. Sits on the table: centre Z =
         table top 0.10 + half height 0.10 = 0.20. Yawed so the marked -X face
         points toward the robot's start for easy detection during the spin. -->
    <model name="aruco_box">
      <!-- On the table's front edge, yawed so the marked -X face points back
           toward the robot's start (origin): the robot then approaches the marker
           head-on (robust detection at all ranges) and ends square in front of
           the box (so the top-down grasp stays aligned). Centre Z = 0.225. -->
      <pose>1.28 -1.0 0.225 0 0 -0.68</pose>
      <link name="box_link">
        <inertial>
          <mass>0.4</mass>
          <!-- Solid box 0.06(X) x 0.30(Y) x 0.25(Z), m=0.4 kg -->
          <inertia>
            <ixx>0.0051</ixx>
            <iyy>0.0022</iyy>
            <izz>0.0031</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box><size>0.06 0.30 0.25</size></box>
          </geometry>
          <!-- High friction so a centred parallel-jaw clamp can hold the slab by
               friction alone (no attach joint). -->
          <surface>
            <friction>
              <ode>
                <mu>2.0</mu>
                <mu2>2.0</mu2>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>100000.0</kp>
                <kd>1.0</kd>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.06 0.30 0.25</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
            <diffuse>0.8 0.2 0.2 1</diffuse>
          </material>
        </visual>
        <!-- Aruco marker on the -X face (0.30 x 0.25). A 0.22 m plate whose ±X
             faces show the marker; the PNG has a 12.5% quiet zone so the marker
             proper is 0.165 m -> detector marker_size must match. -->
        <visual name="marker">
          <pose>-0.0305 0 0 0 0 0</pose>
          <geometry>
            <box><size>0.001 0.22 0.22</size></box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0 0 0 1</specular>
            <pbr>
              <metal>
                <albedo_map>materials/textures/aruco_marker_0.png</albedo_map>
                <metalness>0.0</metalness>
                <roughness>1.0</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- Place table: the destination. Forward-left of the robot's start, same
         low height (top 0.10) and shallow front edge (X=1.20) so the robot can
         drive up and lower the carried box onto it. -->
    <model name="place_table">
      <static>true</static>
      <pose>1.40 0.5 0 0 0 0</pose>
      <link name="table">
        <collision name="slab_c">
          <pose>0 0 0.08 0 0 0</pose>
          <geometry><box><size>0.4 0.5 0.04</size></box></geometry>
        </collision>
        <visual name="slab_v">
          <pose>0 0 0.08 0 0 0</pose>
          <geometry><box><size>0.4 0.5 0.04</size></box></geometry>
          <material><ambient>0.2 0.4 0.5 1</ambient><diffuse>0.2 0.4 0.5 1</diffuse></material>
        </visual>
        <collision name="pillar_c">
          <pose>0 0 0.04 0 0 0</pose>
          <geometry><box><size>0.12 0.12 0.08</size></box></geometry>
        </collision>
        <visual name="pillar_v">
          <pose>0 0 0.04 0 0 0</pose>
          <geometry><box><size>0.12 0.12 0.08</size></box></geometry>
          <material><ambient>0.15 0.3 0.4 1</ambient><diffuse>0.15 0.3 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
