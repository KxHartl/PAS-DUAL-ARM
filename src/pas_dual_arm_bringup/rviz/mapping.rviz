# SLAM mapping view: the map as it builds, the live scan on top of it, and the
# odom->base_footprint pose so map->odom jumps (P-11) are visible as the robot
# stepping sideways relative to the walls it already drew.
#
# TopDownOrtho on purpose: a perspective view exaggerates widths, which is how
# the arm span was misjudged once already (P-35). True proportions matter here
# because the doorways are 1.0 m and the robot is 0.85 m.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Cell Size: 1
      Plane Cell Count: 20
      Value: true
    - Alpha: 0.7
      Class: rviz_default_plugins/Map
      Name: Karta (/map)
      Color Scheme: map
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/LaserScan
      Name: Sken (/scan)
      Color: 255; 85; 0
      Color Transformer: FlatColor
      Size (m): 0.04
      Style: Spheres
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Description Topic:
        Value: /robot_description
      Name: RobotModel
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Marker Scale: 0.5
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Frames:
        All Enabled: false
        map:
          Value: true
        odom:
          Value: true
        base_footprint:
          Value: true
        virtual_base_laser_link:
          Value: true
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Odometrija
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /base_controller/odom
      Keep: 200
      Position Tolerance: 0.2
      Angle Tolerance: 0.2
      Shape:
        Alpha: 0.6
        Color: 0; 170; 255
        Head Length: 0.1
        Head Radius: 0.05
        Shaft Length: 0.2
        Shaft Radius: 0.02
        Value: Arrow
      Value: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 45
      Target Frame: map
      X: 1.5
      Y: -1.5
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1400
